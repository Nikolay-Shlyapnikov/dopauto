          },
          "review@@i@@Car": {
            "type": "string",
            "title": "Отзыв @@i@@: автомобиль"
          },
          "review@@i@@Badge": {
            "type": "string",
            "title": "Отзыв @@i@@: плашка"
          },
          "review@@i@@Text": {
            "$ref": "#/definitions/TextArea",
            "title": "Отзыв @@i@@: текст"
          },
          "review@@i@@Avatar": {
            "$ref": "#/definitions/ImageModel",
            "title": "Отзыв @@i@@: аватар"
          },
          "review@@i@@Photo": {
            "$ref": "#/definitions/ImageModel",
            "title": "Отзыв @@i@@: фото (если нет видео)"
          },
          "review@@i@@Video": {
            "$ref": "#/definitions/VideoModel",
            "title": "Отзыв @@i@@: видео"
          }
        },
